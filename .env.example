# Optional: without these the assistant uses deterministic request parsing.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
# OpenAI-compatible NEAR AI endpoint. Keep API keys on the server.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# Optional JWT; quote requests may work without it, depending on API policy.
ONECLICK_JWT=
# A real merchant-controlled Base address is required for live dry-run quotes.
# Demo confirmation never transfers funds. No deposit address is requested.
MERCHANT_BASE_ADDRESS=
