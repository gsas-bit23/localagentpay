# --- NEAR (testnet) agent payments: server-only secrets, never commit real values ---
# Created by scripts/near/deploy-testnet.mjs (it writes a private .dev.vars outside the repo).
# Relayer: pays gas for guest accounts' meta-transactions and creates g-xxxx.<root> accounts.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
# Agent: function-call key restricted to lap.agent_pay (cannot attach deposits).
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
# Shared key of the "(demo)" merchants, restricted to confirm/refund/set_merchant_active.
DEMO_MERCHANT_PRIVATE_KEY=
# Optional RPC override (default comes from lib/near/deployment.testnet.json).
NEAR_RPC_URL=

# --- NEAR AI Cloud (optional): without these the agent uses the rules planner ---
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
# OpenAI-compatible NEAR AI endpoint. Keep API keys on the server.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# Optional JWT; quote requests may work without it, depending on API policy.
ONECLICK_JWT=
# A real merchant-controlled Base address is required for live dry-run quotes.
# Demo confirmation never transfers funds. No deposit address is requested.
MERCHANT_BASE_ADDRESS=

# Optional Photon-compatible geocoder; no key required for the public default.
PHOTON_BASE_URL=https://photon.komoot.io/

# Required for real travel quote preparation and encrypted order recovery.
# Generate your own random secret; keep it server-only and stable across deploys.
CHECKOUT_SESSION_SECRET=
